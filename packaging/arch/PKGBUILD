# Paquet local : construit depuis l'arbre du dépôt (pas d'archive source), voir README.md.
pkgname=bluez-message
pkgver=0.1.3
pkgrel=1
pkgdesc="bmessage : SMS et appels de l'iPhone sur le PC (relais Bluetooth MAP/PBAP/HFP)"
arch=('x86_64')
license=('MIT')
depends=(
  'glibc' 'gcc-libs' 'sqlite'
  'bluez' 'bluez-utils' 'bluez-obex'
  'pipewire' 'wireplumber'
  'fontconfig' 'ttf-jetbrains-mono-nerd' 'noto-fonts-emoji'
  # Chargées par dlopen (winit, wgpu) : invisibles pour ldd.
  'vulkan-icd-loader' 'libxkbcommon' 'wayland'
  'libx11' 'libxcursor' 'libxi' 'libxrandr'
)
optdepends=(
  'vulkan-driver: rendu léger (~45 Mo), sinon repli OpenGL (~165 Mo)'
  'mesa: repli OpenGL sans pilote Vulkan'
  'notification-daemon: notifications de SMS et d’appel'
)
makedepends=('cargo')
install=bluez-message.install

_root="$startdir/../.."

prepare() {
  cd "$_root"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd "$_root"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release --all-features
}

check() {
  cd "$_root"
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen --release --all-features
}

package() {
  local bin
  for bin in bluez-msg bluez-messaged bluez-message bluez-msg-call; do
    install -Dm755 "$srcdir/target/release/$bin" "$pkgdir/usr/bin/$bin"
  done
  cd "$startdir"
  install -Dm644 bluez-messaged.service "$pkgdir/usr/lib/systemd/user/bluez-messaged.service"
  # Activé pour tous les utilisateurs (comme gnupg) ; refus individuel : systemctl --user mask bluez-messaged.
  install -dm755 "$pkgdir/usr/lib/systemd/user/default.target.wants"
  ln -s ../bluez-messaged.service "$pkgdir/usr/lib/systemd/user/default.target.wants/bluez-messaged.service"
  install -Dm644 bluez-message.desktop "$pkgdir/usr/share/applications/bluez-message.desktop"
  install -Dm644 bluez-message.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/bluez-message.svg"
  install -Dm644 -t "$pkgdir/usr/share/wireplumber/wireplumber.conf.d" 52-bluez-message-roles.conf 53-bluez-message-call-gain.conf
  install -Dm644 "$_root/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 bluez-message-call-gain.lua "$pkgdir/usr/share/wireplumber/scripts/bluez-message-call-gain.lua"
}
