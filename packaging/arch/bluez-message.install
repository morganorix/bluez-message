post_install() {
  cat <<'MSG'
==> bluez-message: the daemon and the audio setup start at your next login.
    Once: pair the iPhone (bluetoothctl: pair <address>, then trust <address>),
    then bmessage > Settings > Bluetooth device: pick the iPhone.
    To start everything without logging out:
      systemctl --user daemon-reload && systemctl --user restart wireplumber && systemctl --user start bluez-messaged
MSG
}

post_upgrade() {
  echo "==> bluez-message: systemctl --user daemon-reload && systemctl --user restart bluez-messaged (or log out)"
}

post_remove() {
  echo "==> bluez-message: systemctl --user stop bluez-messaged && systemctl --user restart wireplumber (or log out)"
}
