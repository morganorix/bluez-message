[Unit]
Description=Relais SMS/appels iPhone (bluez-messaged)
# default.target et non graphical-session.target : sous Hyprland/sway, cette cible
# (RefuseManualStart=yes) reste souvent inactive et le démon ne démarrait jamais.
After=pipewire.service wireplumber.service

[Service]
ExecStart=/usr/bin/bluez-messaged
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
